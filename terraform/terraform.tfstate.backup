        {
          "schema_version": 0,
          "attributes": {
            "additional_authentication_provider": [],
            "api_type": "GRAPHQL",
            "arn": "arn:aws:appsync:ap-southeast-2:323155024975:apis/45cm643cz5eejgwlv23uqgw7xu",
            "authentication_type": "AMAZON_COGNITO_USER_POOLS",
            "enhanced_metrics_config": [],
            "id": "45cm643cz5eejgwlv23uqgw7xu",
            "introspection_config": "ENABLED",
            "lambda_authorizer_config": [],
            "log_config": [],
            "merged_api_execution_role_arn": "",
            "name": "forecasting-api",
            "openid_connect_config": [],
            "query_depth_limit": 0,
            "region": "ap-southeast-2",
            "resolver_count_limit": 0,
            "schema": "schema {\n    query: Query\n    mutation: Mutation\n}\n\n# -------------------------------\n# Queries\n# -------------------------------\ntype Query {\n    runForecastTest(input: ForecastInput): GenericResponse!\n\n    getSKUsMetadata: GenericResponse!\n\n    getReportSummary: GenericResponse!\n\n    getSKUForecasts: GenericResponse!\n\n    getMonthlyTotals: GenericResponse!\n\n    getDailyForecasts: GenericResponse!\n\n    getForecastRun(runId: ID!): ForecastRun\n\n    listForecastRuns(limit: Int, nextToken: String): ForecastRunConnection!\n\n    listNotifications(limit: Int, nextToken: String): NotificationConnection!\n\n    getSkuForecastValues: GenericResponse!\n\n    getReplenishmentSignals: GenericResponse!\n\n    getTenantSettings: TenantSettings\n}\n\ntype Mutation {\n    startForecastRun(input: StartForecastInput!): ForecastRunResponse!\n\n    markNotificationRead(notificationId: ID!): Notification\n\n    setTenantSettings(input: TenantSettingsInput!): TenantSettings\n}\n\n# -------------------------------\n# Generic Lambda response\n# -------------------------------\ntype GenericResponse {\n    status: String!\n    result: AWSJSON\n}\n\ntype ForecastRunResponse {\n    status: String!\n    run: ForecastRun\n    message: String\n}\n\ntype ForecastRun {\n    runId: ID!\n    tenantId: ID!\n    snapshotId: ID\n    status: String!\n    createdAt: AWSDateTime\n    updatedAt: AWSDateTime\n    s3OutputPrefix: String\n    summary: AWSJSON\n}\n\ntype ForecastRunConnection {\n    items: [ForecastRun!]!\n    nextToken: String\n}\n\ntype Notification {\n    notificationId: ID!\n    runId: ID!\n    tenantId: ID!\n    status: String!\n    createdAt: AWSDateTime\n    updatedAt: AWSDateTime\n    read: Boolean!\n    summary: AWSJSON\n}\n\ntype NotificationConnection {\n    items: [Notification!]!\n    nextToken: String\n}\n\ntype TenantSettings {\n    tenantId: ID!\n    model: String\n    mode: String\n    seasonality: String\n    updatedAt: AWSDateTime\n}\n\ninput TenantSettingsInput {\n    model: String\n    mode: String\n    seasonality: String\n}\n\n# -------------------------------\n# Input types\n# -------------------------------\ninput ForecastInput {\n    input_data: AWSJSON\n}\n\ninput StartForecastInput {\n    s3Bucket: String!\n    s3Key: String!\n    originalFilename: String\n    adjustmentsKey: String\n    sku: String\n    store: String\n    frequency: String\n}\n",
            "tags": {},
            "tags_all": {},
            "uris": {
              "GRAPHQL": "https://6dlhtd26mvemnntjwddywewx54.appsync-api.ap-southeast-2.amazonaws.com/graphql",
